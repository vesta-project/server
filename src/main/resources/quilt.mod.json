{
    "schema_version": 1,
    "quilt_loader": {
        "group": "com.vesta",
        "id": "vesta-sync",
        "version": "${version}",
        "metadata": {
            "name": "Vesta Server Sync",
            "description": "Client-server modpack synchronization for Vesta Launcher",
            "contributors": {},
            "license": "LGPL-3.0"
        },
        "intermediate_mappings": "net.fabricmc:intermediary",
        "entrypoints": {
            "init": ["com.vesta.loader.platform.QuiltEntrypoint"]
        },
        "depends": [
            {
                "id": "quilt_loader",
                "versions": ">=0.27.5"
            },
            {
                "id": "minecraft",
                "versions": ">=${minecraft}"
            }
        ]
    }
}
